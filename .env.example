# Скопируйте файл в .env. Сервер читает .env при запуске.
# В кабинете ЮKassa выберите «Добавить магазин» → «Тестовый магазин» → «Онлайн».
# В разделе интеграции возьмите shopId и выпустите секретный ключ тестового магазина.
# https://yookassa.ru/docs/support/merchant/payments/implement/test-store
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Тестовый магазин принимает тестовую карту. Для СБП нужны live и рабочий магазин с подключённой СБП.
YOOKASSA_MODE=test
YOOKASSA_RETURN_URL=http://127.0.0.1:5173/#payment-return

# Для рабочих возвратов задайте отдельный случайный пароль оператора, минимум 32 символа.
# В браузер этот пароль не передаётся. Без него рабочие возвраты через API отключены.
YOOKASSA_REFUND_TOKEN=

# false скрывает панель разработчика и отключает браузерный симулятор.
VITE_IS_DEV_MODE=true
